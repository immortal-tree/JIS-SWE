# Copy this file to .env and fill in your own values. Never commit .env.

# Main database (step 2 of the README creates it)
DATABASE_URL=postgresql://jis:jis_password@localhost:5432/jis

# Separate database for automated tests — it is WIPED on every test run
TEST_DATABASE_URL=postgresql://jis:jis_password@localhost:5432/jis_test

# Secret used to sign login tokens. At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a login lasts, in minutes (480 = 8 hours)
JWT_EXPIRE_MINUTES=480

# The first registrar account, created by: python -m scripts.init_db
REGISTRAR_USERNAME=registrar
REGISTRAR_PASSWORD=
REGISTRAR_NAME=Court Registrar

# Only needed when a browser frontend on another address calls this API.
# Comma-separated. jis-frontend is served on port 5500 (see its README).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
